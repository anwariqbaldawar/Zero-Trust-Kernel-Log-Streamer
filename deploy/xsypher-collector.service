#
# xSypher-Stream collector (kernel side).
#
#   sudo install -m 0644 deploy/xsypher-collector.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now xsypher-collector
#
# Requires a kernel with CONFIG_BPF_LSM=y and `lsm=bpf` on the command line for
# inline enforcement; telemetry works without it (see the "NOTICE" log line).
[Unit]
Description=xSypher-Stream eBPF kernel telemetry collector
Documentation=https://github.com/anwariqbaldawar/xSypher-Stream-Zero-Trust-Kernel-log-Telemetry
After=systemd-udevd.service
Before=xsypher-engine.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xsypher-collector \
    --socket-path /run/xsypher/stream.sock \
    --block-imds \
    --enforce
Restart=on-failure
RestartSec=2s
RuntimeDirectory=xsypher
RuntimeDirectoryMode=0750
StateDirectory=xsypher
LimitMEMLOCK=infinity
LimitNOFILE=65536
# The BPF side needs CAP_BPF/CAP_PERFMON (or CAP_SYS_ADMIN on older kernels);
# everything else is dropped.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_IPC_LOCK
AmbientCapabilities=CAP_BPF CAP_PERFMON
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelLogs=false
ProtectControlGroups=false
RestrictNamespaces=false
# The collector only reads /proc/<pid>/cgroup and writes its socket.
ReadWritePaths=/run/xsypher
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
